 "phrases": [
  {
   "text": "Bagaimana jika suatu hari,",
   "s": 0.0,
   "e": 1.818
  },
  {
   "text": "Belanda justru menjadi negara jajahan Indonesia?",
   "s": 1.994,
   "e": 4.891
  },
  {
   "text": "Bayangkan tahun 1600-an.",
   "s": 5.559,
   "e": 7.66
  },
  {
   "text": "Alih-alih VOC menguasai Nusantara,",
   "s": 8.129,
   "e": 10.548
  },
  {
   "text": "kerajaan-kerajaan di Indonesia justru bersatu dan membangun armada laut yang sangat kuat.",
   "s": 10.922,
   "e": 16.297
  },
  {
   "text": "Mereka menyerang pelabuhan-pelabuhan Belanda,",
   "s": 16.833,
   "e": 18.973
  },
  {
   "text": "menguasai perdagangan,",
   "s": 19.311,
   "e": 20.551
  },
  {
   "text": "bahkan mendirikan pemerintahan kolonial di Amsterdam.",
   "s": 20.833,
   "e": 23.649
  },
  {
   "text": "Kini,",
   "s": 24.182,
   "e": 24.62
  },
  {
   "text": "orang Belanda harus belajar bahasa Indonesia.",
   "s": 24.804,
   "e": 27.516
  },
  {
   "text": "Tulip dan keju dikirim ke Nusantara,",
   "s": 27.965,
   "e": 30.268
  },
  {
   "text": "dan Amsterdam menjadi pusat pemerintahan kolonial.",
   "s": 30.574,
   "e": 33.438
  },
  {
   "text": "Tapi ada satu pertanyaan besar.",
